# ==============================================
# AI Personal Trainer - Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to git - it's in .gitignore

# ==============================================
# APPLICATION SETTINGS
# ==============================================
# Your deployed app URL (for production)
NEXT_PUBLIC_APP_URL=https://your-app-name.vercel.app

# Environment (development, staging, production)
NODE_ENV=production

# ==============================================
# CLERK AUTHENTICATION
# ==============================================
# Get these from https://dashboard.clerk.com/
# Required for user authentication and management

# Public key (safe to expose in frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret key (keep private!)
CLERK_SECRET_KEY=sk_test_...

# Webhook secret (for user lifecycle events)
CLERK_WEBHOOK_SECRET=whsec_...

# ==============================================
# DATABASE (NeonDB PostgreSQL)
# ==============================================
# Get from https://console.neon.tech/
# Connection string format: postgresql://[user]:[password]@[host]/[database]?sslmode=require

DATABASE_URL=postgresql://username:password@host.neon.tech/database?sslmode=require

# Optional: Separate read/write connections for performance
DATABASE_URL_POOLED=postgresql://username:password@pooler-host.neon.tech/database?sslmode=require

# ==============================================
# AI SERVICES
# ==============================================
# OpenAI API for workout generation and AI features
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: Alternative AI providers
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...

# ==============================================
# MONITORING & ANALYTICS (OPTIONAL)
# ==============================================
# Sentry for error tracking (recommended for production)
# Get from https://sentry.io/
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project

# PostHog for user analytics (optional)
# Get from https://posthog.com/
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ==============================================
# DEVELOPMENT & TESTING
# ==============================================
# Test user credentials for development/testing
# Create a test user in Clerk dashboard
CLERK_CLAUDE_TEST_USER_EMAIL=test@example.com
CLERK_CLAUDE_TEST_USER_PASSWORD=TestPassword123!

# Feature flags for development
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# ==============================================
# SECURITY SETTINGS
# ==============================================
# JWT signing secret (generate a random string)
JWT_SECRET=your-jwt-secret-key-here

# Encryption key for sensitive data
ENCRYPTION_KEY=your-32-character-encryption-key

# ==============================================
# EMAIL & NOTIFICATIONS (FUTURE)
# ==============================================
# SMTP settings for transactional emails
# EMAIL_FROM=noreply@yourapp.com
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# ==============================================
# STORAGE (FUTURE)
# ==============================================
# For user uploads, workout images, etc.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-app-uploads

# ==============================================
# SETUP INSTRUCTIONS
# ==============================================
# 1. Copy this file to .env.local
# 2. Sign up for Clerk (authentication): https://clerk.com/
# 3. Create NeonDB database: https://neon.tech/
# 4. Get OpenAI API key: https://openai.com/
# 5. Fill in all required variables above
# 6. Run: pnpm validate:env (to check your setup)
# 7. Run: pnpm dev (to start development)
#
# Need help? Check the README.md or DEVELOPER_GUIDE.md