{
  "extends": ["next/core-web-vitals", "prettier"],
  "rules": {
    // General code quality
    "prefer-const": "error",
    "no-var": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-debugger": "error",
    
    // Best practices
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    
    // Accessibility
    "jsx-a11y/anchor-is-valid": "off"
  }
}