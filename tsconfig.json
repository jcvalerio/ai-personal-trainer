{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "ES2020"],
    "allowJs": true,
    "checkJs": false,

    /* Modules */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Type Checking - Strict Mode */
    "strict": true,
    // Strict type checking (gradually enabled)
    "noUnusedLocals": true, // Enabled: Catch unused variables
    "noUnusedParameters": false, // TODO: Re-enable after parameter cleanup
    "exactOptionalPropertyTypes": false, // Keep disabled for flexibility
    "noImplicitReturns": true, // Enabled: All code paths must return
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true, // Enabled: Safer array/object access
    "noImplicitAny": true, // Enabled: Require explicit types
    "noImplicitOverride": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,

    /* Emit */
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "./dist",
    "removeComments": true,
    "noEmitOnError": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    /* Skip Type Checking */
    "skipLibCheck": true,

    /* Path Mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/types/*": ["./types/*"],
      "@/styles/*": ["./styles/*"],
      "@/app/*": ["./app/*"],
      "@/public/*": ["./public/*"]
    },

    /* Next.js specific */
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.original.ts",
    "**/*.original.tsx",
    "lib/services/exercise-service.ts",
    "lib/services/workout-service.ts",
    "scripts/*.ts",
    "playwright.config.ts",
    "types/calendar-scheduling.ts",
    "types/goal-tracking.ts",
    "types/plan-dashboard.ts",
    "types/progress-analytics.ts",
    "types/template-browser.ts",
    "components/workouts/**/*.tsx",
    "lib/api/workout-plans.ts",
    "lib/services/offline-storage-service.ts",
    "lib/stores/dashboard-store.ts",
    "tests/**/*.ts"
  ],
  "ts-node": {
    "esm": true,
    "compilerOptions": {
      "module": "esnext",
      "moduleResolution": "node"
    }
  }
}
