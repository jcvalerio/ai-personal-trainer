#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
  echo -e "${2}${1}${NC}"
}

# Check if we're in the right directory
if [ ! -f "package.json" ]; then
  print_status "❌ Error: package.json not found. Make sure you're in the project root." $RED
  exit 1
fi

# 1. Environment validation
print_status "📋 Validating environment..." $YELLOW
if ! pnpm env:validate --quiet; then
  print_status "❌ Environment validation failed. Fix environment variables before committing." $RED
  print_status "💡 Run: pnpm env:check for detailed information" $YELLOW
  exit 1
fi
print_status "✅ Environment validation passed" $GREEN

# 2. TypeScript type checking
print_status "🔧 Running TypeScript checks..." $YELLOW
if ! pnpm type-check; then
  print_status "❌ TypeScript errors found. Fix them before committing." $RED
  exit 1
fi
print_status "✅ TypeScript checks passed" $GREEN

# 3. ESLint
print_status "🧹 Running ESLint..." $YELLOW
if ! pnpm lint; then
  print_status "❌ ESLint errors found." $RED
  print_status "💡 Try running: pnpm lint:fix" $YELLOW
  exit 1
fi
print_status "✅ ESLint checks passed" $GREEN

# 4. Prettier formatting
print_status "💅 Checking code formatting..." $YELLOW
if ! pnpm format:check; then
  print_status "❌ Code formatting issues found." $RED
  print_status "💡 Running Prettier to fix formatting..." $YELLOW
  pnpm format
  print_status "✅ Code formatted. Please review and commit again." $GREEN
  exit 1
fi
print_status "✅ Code formatting is correct" $GREEN

# 5. Check for sensitive information
print_status "🔒 Checking for sensitive information..." $YELLOW
if git diff --cached --name-only | xargs grep -l "sk-\|pk_\|password\|secret\|token" > /dev/null 2>&1; then
  print_status "⚠️  WARNING: Potential sensitive information detected!" $YELLOW
  print_status "Please review your changes for API keys, passwords, or secrets." $YELLOW
  git diff --cached --name-only | xargs grep -n "sk-\|pk_\|password\|secret\|token" || true
  echo ""
  read -p "Are you sure you want to commit? (y/N): " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    print_status "❌ Commit cancelled by user" $RED
    exit 1
  fi
fi
print_status "✅ Security check passed" $GREEN

# 6. Quick build check (only for major changes)
if git diff --cached --name-only | grep -E "(package\.json|tsconfig\.json|next\.config\.js|tailwind\.config\.ts)" > /dev/null; then
  print_status "🏗️ Configuration files changed, running build check..." $YELLOW
  if ! pnpm build; then
    print_status "❌ Build failed. Fix build errors before committing." $RED
    exit 1
  fi
  print_status "✅ Build check passed" $GREEN
fi

print_status "🎉 All pre-commit checks passed! Ready to commit." $GREEN