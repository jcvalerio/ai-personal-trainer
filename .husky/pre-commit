#!/usr/bin/env sh
. "\$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running lint-staged on staged files..."

# Keep pre-commit fast and focused; CI enforces full checks
pnpm lint-staged

status=$?
if [ $status -ne 0 ]; then
  echo "❌ Pre-commit checks failed. Fix issues and re-commit."
  exit $status
fi

echo "✅ Pre-commit checks passed."
